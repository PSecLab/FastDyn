# BoardRunner SDK Build Configuration
#
# This file is read by `fastdyn llm --compile` to locate the include
# directories needed for building device models.
#
# Fill in the absolute paths below and save this file.
# Lines starting with # are comments and are ignored.

# Path to FastDyn include directory (must contain device.h)
FASTDYN_INCLUDE_DIR=/scratch/Fastdyn/ardurover_rehosting_fastdyn/clean_rehosting/FastDyn/include

# Path to QEMU include directory
QEMU_INCLUDE_DIR=/scratch/Fastdyn/ardurover_rehosting_fastdyn/clean_rehosting/qemu/include

