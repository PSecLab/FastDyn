system("mkdir -p output_folder"); 
res := cd("output_folder");

//Debug mode
setDebugFlags("failtrace"); 

// Load the model
load_status := loadFile("../TempSensor.mo");

print("Load Status: " + String(load_status) + "\n");

// Set FMI export options (2.0, Co-Simulation)
//setCommandLineOptions("--fmiVersion=2.0 --fmiType=cs");
translateModelFMU(RealisticTempSensor, "2.0", "cs");

// Export the FMU
translateModelFMU(RealisticTempSensor);

// Check for errors
getErrorString();
