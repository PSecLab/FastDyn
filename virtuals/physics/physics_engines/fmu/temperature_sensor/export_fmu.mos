system("mkdir -p output_folder"); 
res := cd("output_folder");

//Debug mode
setDebugFlags("failtrace"); 

// Load the model
loadFile("../TempSensor.mo");

// Set FMI export options (2.0, Co-Simulation)
//setCommandLineOptions("--fmiVersion=2.0 --fmiType=cs");
translateModelFMU(TempSensor, "2.0", "cs");

// Export the FMU
translateModelFMU(TempSensor);

// Check for errors
getErrorString();
